#include <stdio.h>
#include <windows.h>

int main(void)
{
	SetConsoleOutputCP(CP_UTF8);
	int h, w;
	printf("Введите длину и ширину: ");
	if (scanf("%d %d", &h, &w) != 2) {
    printf("Input error\n");
    return 1;
	}
	if (h < 2 || h > 10 || w < 2 || w > 10) {
		printf("Range error\n");
		return 1;
	}

	for (int row = 1; row <= h; row++){
		for (int col = 1; col <= w; col++) {
			if (row == 1 || col == 1 || row == h || col == w){
				printf("*");
			}
			else {
				printf(" ");
			}
		}
		printf("\n");
	}
	return 0;
}
